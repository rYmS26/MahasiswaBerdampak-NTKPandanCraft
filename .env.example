# Supabase Public Config (aman untuk client & SSR; jangan masukkan secret key di sini)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-Only Secret Key (hanya di Vercel Environment Variables / .env.local, untuk menyimpan pesanan ke tabel orders)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Konfigurasi Toko & WhatsApp Penjual (opsional, default sudah terisi)
NEXT_PUBLIC_SELLER_WHATSAPP=628815838516
NEXT_PUBLIC_SITE_URL=https://your-vercel-app.vercel.app
