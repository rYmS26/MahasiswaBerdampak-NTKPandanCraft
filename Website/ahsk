        <script>
          let currentSelectedProduct = "Monstera Deliciosa";
          let currentSelectedPrice = "$38.00";

          function openOrderModal(productName, price) {
            currentSelectedProduct = productName;
            currentSelectedPrice = price;

            document.getElementById("modal-product-name").innerText =
              productName;
            document.getElementById("modal-product-price").innerText = price;
            document.getElementById("order-note-input").value = "";

            updateModalMessagePreview();

            const modal = document.getElementById("wa-order-modal");
            const card = document.getElementById("wa-order-modal-card");
            modal.classList.remove("opacity-0", "pointer-events-none");
            modal.classList.add("opacity-100");
            card.classList.remove("scale-95");
            card.classList.add("scale-100");
          }

          function closeOrderModal() {
            const modal = document.getElementById("wa-order-modal");
            const card = document.getElementById("wa-order-modal-card");
            modal.classList.add("opacity-0", "pointer-events-none");
            modal.classList.remove("opacity-100");
            card.classList.add("scale-95");
            card.classList.remove("scale-100");
          }

          function updateModalMessagePreview() {
            const note = document
              .getElementById("order-note-input")
              .value.trim();
            let msg = `Halo GreenNest, saya ingin memesan ${currentSelectedProduct} seharga ${currentSelectedPrice}. Apakah stok masih tersedia?`;
            if (note) {
              msg += `\n\nCatatan tambahan: ${note}`;
            }
            document.getElementById("modal-message-preview").innerText = msg;
          }

          function sendToWhatsApp() {
            const msg = document.getElementById(
              "modal-message-preview",
            ).innerText;
            const encodedMsg = encodeURIComponent(msg);
            const waUrl = `https://wa.me/6281234567890?text=${encodedMsg}`;
            window.open(waUrl, "_blank");
            closeOrderModal();
          }

          function filterCatalog(category, btnElement) {
            const buttons = document.querySelectorAll(
              "#catalog-filters .catalog-tab-btn",
            );
            buttons.forEach((btn) => {
              btn.classList.remove(
                "bg-primary",
                "text-on-primary",
                "shadow-sm",
              );
              btn.classList.add(
                "bg-surface-container",
                "text-on-surface-variant",
              );
            });

            btnElement.classList.remove(
              "bg-surface-container",
              "text-on-surface-variant",
            );
            btnElement.classList.add(
              "bg-primary",
              "text-on-primary",
              "shadow-sm",
            );

            const items = document.querySelectorAll(
              "#catalog-grid .product-item",
            );
            items.forEach((item) => {
              const itemCategories = item.getAttribute("data-category") || "";
              if (category === "all" || itemCategories.includes(category)) {
                item.style.display = "flex";
              } else {
                item.style.display = "none";
              }
            });
          }

          // Close modal on Escape
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeOrderModal();
          });

          // Close modal on clicking backdrop
          document
            .getElementById("wa-order-modal")
            .addEventListener("click", (e) => {
              if (e.target.id === "wa-order-modal") closeOrderModal();
            });
        </script>
